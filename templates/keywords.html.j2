<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ topic }} - 关键词词云图</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #ffffff;
            text-align: center;
        }
        .wordcloud-container {
            padding: 20px;
            text-align: center;
        }
        .python-wordcloud img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }
        .loading {
            text-align: center;
            padding: 40px;
            color: #666;
            font-size: 18px;
        }
    </style>
</head>
<body>
    <div class="wordcloud-container">
        {% if image_filename %}
            <div class="python-wordcloud">
                <img src="./{{ image_filename }}" alt="{{ topic }} - 关键词词云图" style="max-width: 100%; height: auto; border-radius: 10px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);">
            </div>
        {% else %}
            <div class="loading">正在生成词云图...</div>
            <canvas id="wordcloud" class="wordcloud-canvas" width="800" height="600"></canvas>
        {% endif %}
    </div>
</body>
</html>
