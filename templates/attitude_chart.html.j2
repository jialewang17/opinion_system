<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <style>
    html, body { height: 100%; margin: 0; padding: 20px; }
    .container { max-width: 1200px; margin: 0 auto; }
    .chart-container { margin: 20px 0; }
    .chart-title { text-align: center; font-size: 18px; font-weight: bold; margin-bottom: 10px; }
    .chart-wrapper { width: 100%; height: 500px; margin: 0 auto; }
    .summary-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .summary-table th, .summary-table td { padding: 8px 12px; text-align: left; border: 1px solid #ddd; }
    .summary-table th { background-color: #f5f5f5; font-weight: bold; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
</head>
<body>
  <div class="container">
    <h1 style="text-align: center;">{{ title }}</h1>

    {% if summary %}
    <div class="summary-section">
      <h2>数据摘要</h2>
      <table class="summary-table">
        <tr>
          <th>总记录数</th>
          <td>{{ summary.total_count }}</td>
        </tr>
        <tr>
          <th>正面数量</th>
          <td>{{ summary.positive_count }} ({{ "%.2f"|format(summary.positive_ratio * 100) }}%)</td>
        </tr>
        <tr>
          <th>负面数量</th>
          <td>{{ summary.negative_count }} ({{ "%.2f"|format(summary.negative_ratio * 100) }}%)</td>
        </tr>
        <tr>
          <th>中性数量</th>
          <td>{{ summary.neutral_count }} ({{ "%.2f"|format(summary.neutral_ratio * 100) }}%)</td>
        </tr>
      </table>
    </div>
    {% endif %}

    {% if option_json %}
    <div class="chart-container">
      <div class="chart-title">{{ chart_title or title }}</div>
      <div class="chart-wrapper" id="chart"></div>
    </div>
    {% endif %}
  </div>

  {% if option_json %}
  <script>
    const chartDom = document.getElementById('chart');
    const myChart = echarts.init(chartDom);
    const option = {{ option_json|safe }};
    myChart.setOption(option);

    // 响应式调整
    window.addEventListener('resize', function() {
      myChart.resize();
    });
  </script>
  {% endif %}
</body>
</html>
